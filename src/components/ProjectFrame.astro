---
// One project fills one frame, laid out like a deck page:
//
//   Client: / Project:  + figures  |  description
//   ─────────────── media row ───────────────
//   ────────── press logo band ───────────────
//   ─────────── remaining media ──────────────
//
// The press band is a full-width strip between the media rows, exactly as
// the deck sets it. Media entries ending in .mp4 render as muted looping
// film moments. A project with `video` (self-hosted mp4) or `youtube` (video
// id) gets a real play affordance on its feature tile — clicking swaps in
// the player (wired up in src/scripts/app.js).
import { PRESS } from '../data/projects.js';
import { withBase } from '../lib/paths.js';

const { project } = Astro.props;

// media entries are strings or { src, pos } (pos anchors the crop, e.g.
// 'top' keeps a press clipping's headline in view)
const media = [project.hero, ...(project.images || [])]
  .filter(Boolean)
  .map((m) => (typeof m === 'string' ? { src: m } : m));

const film = project.disciplines.includes('Film');
const playable = Boolean(project.video || project.youtube);
const showPlay = film || playable;
const stickers = project.stickers || [];

// a press logo links out to the actual coverage when we have the URL
const press = (project.press || [])
  .filter((k) => PRESS[k])
  .map((k) => ({ file: PRESS[k], url: (project.pressLinks || {})[k] }));

// the deck prints figures as one inline rule-separated line
const figures = (project.stats || []).map((s) => `${s.figure} ${s.label}`);

// --- split the media either side of the press band -------------------------
// With stickers (OnlyNans) the deck gives the hero a narrow sticker column
// beside it; otherwise the top row takes the first two tiles.
let top;
let rest;
if (stickers.length > 0) {
  top = media.slice(0, 1);
  rest = media.slice(1);
} else if (press.length > 0) {
  top = media.slice(0, 2);
  rest = media.slice(2);
} else {
  top = media;
  rest = [];
}

// grid for the top group
function topGrid(n) {
  if (stickers.length > 0) return { cols: '1fr auto', rows: '1fr', areas: '"m0 stickers"' };
  if (n <= 1) return { cols: '1fr', rows: '1fr', areas: '"m0"' };
  if (n === 2) return { cols: '1.5fr 1fr', rows: '1fr', areas: '"m0 m1"' };
  if (n === 3) return { cols: '1.5fr 1fr', rows: '1fr 1fr', areas: '"m0 m1" "m0 m2"' };
  const rows = Math.ceil(n / 2);
  const areas = Array.from(
    { length: rows },
    (_, r) => `"m${r * 2} m${Math.min(r * 2 + 1, n - 1)}"`
  ).join(' ');
  return { cols: '1fr 1fr', rows: `repeat(${rows}, 1fr)`, areas };
}

const g = topGrid(top.length);
const topStyle = `grid-template-columns:${g.cols};grid-template-rows:${g.rows};grid-template-areas:${g.areas};`;

// the quote rides at the head of the lower row, as a clipping would
const restCells = (project.quote ? 1 : 0) + rest.length;
const restStyle = `grid-template-columns:repeat(${Math.max(restCells, 1)}, 1fr);`;

const isLoop = (m) => m.src.endsWith('.mp4');
---

<section class="vj-frame">
  <header class="vj-frame-header">
    <div class="vj-frame-id">
      <p class="vj-frame-line"><span class="vj-frame-key">Client:</span> {project.client}</p>
      <p class="vj-frame-line"><span class="vj-frame-key">Project:</span> {project.title}</p>
      {
        figures.length > 0 && (
          <p class="vj-figures">
            {figures.map((f, i) => (
              <>
                {i > 0 && <span class="vj-figures-sep">|</span>}
                <span>{f}</span>
              </>
            ))}
          </p>
        )
      }
    </div>
    {project.description && <p class="vj-frame-desc">{project.description}</p>}
  </header>

  <div class="vj-frame-body">
    {
      top.length > 0 && (
        <div class="vj-collage vj-collage-top" style={topStyle}>
          {top.map((m, i) => {
            const feature = i === 0;
            const playsHere = feature && playable;
            const Tile = playsHere ? 'button' : 'div';
            return (
              <Tile
                class:list={['vj-tile', { 'vj-tile-playable': playsHere }]}
                style={`grid-area:m${i}`}
                data-video={playsHere && project.video ? withBase(project.video) : undefined}
                data-youtube={playsHere ? project.youtube : undefined}
                aria-label={playsHere ? `Play the ${project.title} film` : undefined}
              >
                {isLoop(m) ? (
                  <video
                    class="vj-tile-media"
                    src={withBase(m.src)}
                    autoplay
                    muted
                    loop
                    playsinline
                    preload="metadata"
                  />
                ) : (
                  <img
                    class:list={['vj-tile-media', { 'vj-tile-media-card': m.fit === 'contain' }]}
                    src={withBase(m.src)}
                    alt=""
                    style={m.pos ? `object-position:${m.pos}` : undefined}
                    loading={feature ? 'eager' : 'lazy'}
                    fetchpriority={feature ? 'high' : undefined}
                  />
                )}
                {feature && showPlay && (
                  <div class="vj-play">
                    <div class="vj-play-ring">
                      <svg width="26" height="30" viewBox="0 0 26 30" aria-hidden="true">
                        <path d="M2 2 L24 15 L2 28 Z" fill="#fff" />
                      </svg>
                    </div>
                  </div>
                )}
              </Tile>
            );
          })}
          {stickers.length > 0 && (
            <div class="vj-stickers" style="grid-area:stickers">
              {stickers.map((s) => (
                <img class="vj-sticker" src={withBase(s.src)} alt="" loading="lazy" />
              ))}
            </div>
          )}
        </div>
      )
    }

    {
      press.length > 0 && (
        <div class="vj-pressband">
          {press.map(({ file, url }) =>
            url ? (
              <a href={url} target="_blank" rel="noopener" class="vj-press-link" aria-label="Read the coverage">
                <img src={withBase(`assets/press/${file}`)} alt="" loading="lazy" />
              </a>
            ) : (
              <img src={withBase(`assets/press/${file}`)} alt="" loading="lazy" />
            )
          )}
        </div>
      )
    }

    {
      restCells > 0 && (
        <div class="vj-collage vj-collage-rest" style={restStyle}>
          {project.quote && (
            <figure class="vj-quote">
              <blockquote>&lsquo;{project.quote.text}&rsquo;</blockquote>
              <figcaption>&ndash; {project.quote.source}</figcaption>
            </figure>
          )}
          {rest.map((m) => (
            <div class="vj-tile">
              {isLoop(m) ? (
                <video
                  class="vj-tile-media"
                  src={withBase(m.src)}
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="metadata"
                />
              ) : (
                <img
                  class:list={['vj-tile-media', { 'vj-tile-media-card': m.fit === 'contain' }]}
                  src={withBase(m.src)}
                  alt=""
                  style={m.pos ? `object-position:${m.pos}` : undefined}
                  loading="lazy"
                />
              )}
            </div>
          ))}
        </div>
      )
    }
  </div>
</section>
